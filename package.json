{
  "name": "flow-ai-manager",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test:diagnostics": "node --test tests/diagnostics.test.mjs tests/error-help-ui.test.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "test:comfy": "node --test tests/comfy-home.test.mjs",
    "build": "pnpm run check && vite build",
    "tauri": "tauri",
    "start": "tauri dev",
    "dist:win": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  }
}
